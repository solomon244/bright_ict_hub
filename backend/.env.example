NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/ethio_tech_hub

# Required in production: both at least 32 random characters
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated origins allowed by CORS (your deployed frontend URL(s))
CLIENT_URL=http://localhost:5173

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

UPLOAD_DIR=

RESET_TOKEN_EXPIRY_MINUTES=30
VERIFY_TOKEN_EXPIRY_MINUTES=60

# AI tutor + dashboard coach (Google AI Studio / Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production: set ENABLE_API_DOCS=true only if you want Swagger UI exposed publicly
# ENABLE_API_DOCS=false

# --- AI layer ---------------------------------------------------------------
# gemini (default) or openai (any OpenAI-compatible API; set OPENAI_BASE_URL for other vendors)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Max successful AI calls per student per UTC day (cost control)
AI_DAILY_LIMIT_PER_USER=50
AI_REQUEST_TIMEOUT_MS=30000
# Optional, USD per 1,000 tokens — enables the cost estimate in /api/admin/ai/usage
AI_COST_PER_1K_INPUT=
AI_COST_PER_1K_OUTPUT=
# How long a generated dashboard coach card is reused per student (ms, default 6 hours)
COACH_CACHE_TTL_MS=
